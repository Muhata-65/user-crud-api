{
  "info": {
    "_postman_id": "caec3906-64d7-48ec-bb85-f510495bb92e",
    "name": "Users REST API",
    "description": "CRUD and validation checks for the Node.js, Express, and SQLite users API. Run the requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "" },
    { "key": "testEmail", "value": "ada.lovelace@example.com" }
  ],
  "item": [
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"{{testEmail}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Creates user with 201', function () { pm.response.to.have.status(201); });",
            "const user = pm.response.json();",
            "pm.test('Response contains user fields', function () { pm.expect(user).to.have.property('id'); pm.expect(user.name).to.eql('Ada Lovelace'); pm.expect(user.email).to.eql(pm.collectionVariables.get('testEmail')); });",
            "pm.collectionVariables.set('userId', user.id);"
          ]
        }
      }]
    },
    {
      "name": "Get all users",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Lists users with 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Response is an array containing created user', function () { const users = pm.response.json(); pm.expect(users).to.be.an('array'); pm.expect(users.some(function (user) { return String(user.id) === pm.collectionVariables.get('userId'); })).to.be.true; });"
          ]
        }
      }]
    },
    {
      "name": "Get user by ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Returns user with 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Returned ID matches requested ID', function () { pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('userId')); });"
          ]
        }
      }]
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada Byron\",\n  \"email\": \"{{testEmail}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Updates user with 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Updated name is returned', function () { pm.expect(pm.response.json().name).to.eql('Ada Byron'); });"
          ]
        }
      }]
    },
    {
      "name": "Delete user",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Deletes user with 204', function () { pm.response.to.have.status(204); });"
          ]
        }
      }]
    },
    {
      "name": "Get deleted user (404 check)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Missing user returns 404', function () { pm.response.to.have.status(404); });"
          ]
        }
      }]
    },
    {
      "name": "Invalid user input (400 check)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/users"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Invalid data returns 400', function () { pm.response.to.have.status(400); });",
            "pm.test('Error response explains validation failure', function () { pm.expect(pm.response.json()).to.have.property('error'); });"
          ]
        }
      }]
    }
  ]
}
